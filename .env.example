# Local only: copy to .env (git-ignored). On Vercel, set these in Project → Settings → Environment Variables.
# Read by the server only; never sent to the browser. Without a key, Sift shows clearly marked mock scores.
TYPESAFE_API_KEY=
# JEV_MODEL=jev-1.13.0
# BLINDFOLD_REDACTION=name   # name (default): hide name + email/phone/links. full: fully blind.
