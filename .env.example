# Local only: copy to .env (git-ignored). On Vercel, set these in Project → Settings → Environment Variables.
# Read by the server only; never sent to the browser.
TYPESAFE_API_KEY=
# Live scoring needs a password too. People type it in Settings; without it Sift uses mock scores.
DEMO_PASSWORD=
# DEMO_MODE=true             # force mock scores for everyone (public demo)
# JEV_MODEL=jev-1.13.0
# BLINDFOLD_REDACTION=name   # name (default): hide name + email/phone/links. full: fully blind.
